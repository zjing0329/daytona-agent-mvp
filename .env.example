# local = dry-run filesystem backend; daytona = real Daytona backend; auto uses daytona when DAYTONA_API_KEY exists.
MVP_BACKEND=local
MVP_MAX_SANDBOXES=20
MVP_WORKSPACE_DIR=/workspace
MVP_AGENT_COMMAND=python /workspace/agent.py
MVP_COMMAND_TIMEOUT_SECONDS=900
MVP_STATE_DIR=.state

# Real Daytona backend
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=
DAYTONA_TARGET=
DAYTONA_IMAGE=python:3.12-slim
DAYTONA_SNAPSHOT=
DAYTONA_AUTO_STOP_MINUTES=60
DAYTONA_EPHEMERAL=true

# Optional: use the local SDK source instead of a pip-installed daytona package.
DAYTONA_SDK_PATH=/Users/zjing/Documents/git/daytona/libs/sdk-python/src

